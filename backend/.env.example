# API environment variables. Copy this file to backend/.env for local development;
# in production (Render) set them in the service dashboard instead.

PORT=5000

# Secret used to sign login tokens (JWTs). Use a long random string, for example the
# output of: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string

# Comma-separated list of frontend origins allowed to call the API from a browser.
# Defaults to http://localhost:3000,https://ian-joseph.netlify.app when unset.
CORS_ORIGINS=http://localhost:3000,https://ian-joseph.netlify.app

# MongoDB connection string. The app uses the `imgupload` database.
MONGODB_URI=mongodb+srv://your_user:your_password@your_cluster.mongodb.net/?retryWrites=true&w=majority

# Optional: Redis with the RedisBloom module (e.g. Redis Stack or Redis Cloud) keeps a
# Bloom filter of registered emails so most sign-up checks skip MongoDB. Leave these
# unset to check emails in MongoDB only.
# Option 1: a single instance. When REDIS_URL is set, the three variables below are ignored.
# REDIS_URL=redis://default:your_redis_password@your_redis_host:6379
# Option 2: a local cluster whose nodes listen on REDIS_PORT, REDIS_PORT+1 and REDIS_PORT+2.
# REDIS_HOST=127.0.0.1
# REDIS_PORT=7000
# REDIS_PASSWORD=your_redis_password

# Verification emails. Configure at least one way to send them; they are tried in the
# order below. With none, codes are printed to the server log, which is enough for
# local development. Step-by-step setup: docs/email-setup.md
#
# The sender address (the Gmail account behind the OAuth token or App Password).
EMAIL_USER=

# 1. Gmail API over HTTPS (recommended). Works on hosts that block SMTP, such as
#    Render's free tier, and needs the https://www.googleapis.com/auth/gmail.send scope.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# 2. Resend HTTPS API. It only delivers to your own address until you verify a domain
#    in Resend and set RESEND_FROM to an address on that domain.
RESEND_API_KEY=
RESEND_FROM=KuisAnak <onboarding@resend.dev>

# 3. SMTP: a 16-character Gmail App Password (https://myaccount.google.com/apppasswords),
#    or a custom relay through EMAIL_HOST. Render's free tier blocks outgoing SMTP.
EMAIL_PASS=
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_SECURE=false
