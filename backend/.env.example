# API environment variables. Copy this file to backend/.env for local development;
# in production (Render) set them in the service dashboard instead.

PORT=5000

# MongoDB connection string. The app uses the `imgupload` database.
MONGODB_URI=mongodb+srv://your_user:your_password@your_cluster.mongodb.net/?retryWrites=true&w=majority

# Redis with the RedisBloom module (e.g. Redis Stack or Upstash), used for the
# email-availability Bloom filter.
# Option 1: a single instance. When REDIS_URL is set, the three variables below are ignored.
REDIS_URL=redis://default:your_redis_password@your_redis_host:6379
# Option 2: a local cluster whose nodes listen on REDIS_PORT, REDIS_PORT+1 and REDIS_PORT+2.
REDIS_HOST=127.0.0.1
REDIS_PORT=7000
REDIS_PASSWORD=your_redis_password

# Verification emails go through the Resend HTTPS API when RESEND_API_KEY is set,
# falling back to Gmail via Nodemailer. Codes are also printed to the server log,
# which is enough for local development.
RESEND_API_KEY=
RESEND_FROM=KuisAnak <onboarding@resend.dev>

EMAIL_USER=your_address@gmail.com
# Gmail option 1 (recommended): a 16-character App Password,
# generated at https://myaccount.google.com/apppasswords
EMAIL_PASS=your_16_character_app_password
# Gmail option 2: OAuth2 credentials, used when EMAIL_PASS is not set
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REFRESH_TOKEN=your_google_refresh_token
# Plain SMTP relay, used only when neither Gmail option is configured
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_SECURE=false
